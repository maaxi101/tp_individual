# Puerto del backend (la app móvil apunta a http://<IP de la PC>:8000)
SERVER_PORT=8000
# Orígenes permitidos por CORS, separados por coma. Vacío = todos.
# Solo aplica a clientes web; la app React Native no lo necesita.
ALLOWED_ORIGINS=
# Minutos que una compra PENDIENTE reserva el cupo antes de vencer (default 10).
# Para mostrar el vencimiento en la demo se puede bajar a 1.
RESERVA_MINUTOS=10
